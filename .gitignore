*.db
claude_desktop_config.json
whatsapp.log
whatsapp-bridge/bridge.err.log
whatsapp-bridge/bridge.log
whatsapp-bridge/whatsapp-bridge
whatsapp-bridge/whatsapp-client
whatsapp-bridge/whatsapp-bridge.exe
whatsapp-bridge/whatsapp-client.exe
# go build leaves a .exe~ behind when the target is locked by a running bridge.
*.exe~

# The WhatsApp session and everything synced from it: messages, contacts and
# downloaded media. *.db already covered the databases, but the media
# subdirectories were not — and this is the user's private conversation data.
whatsapp-bridge/store/

# Worktrees created by subagents inside the repo.
.claude/worktrees/
whatsapp-bridge/transcription.env
whatsapp-bridge-personal/

# systemd EnvironmentFile (sem export, contém Groq key)
whatsapp-bridge/transcription.systemd.env

# Mesma coisa em qualquer diretório: os instaladores colocam transcription.env
# na raiz do INSTALL_DIR (que pode ser o próprio clone), e o arquivo contém uma
# chave de API em texto claro. As entradas acima só cobriam whatsapp-bridge/.
transcription.env
transcription.systemd.env

# Reversa
.reversa/
_reversa_sdd/

# Launchers generated by the installers: they hard-code this machine's install
# path and port, so they are per-machine, not repository content.
start-bridge.ps1
start-bridge.sh
